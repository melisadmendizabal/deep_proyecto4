# Copien este archivo como .env y peguen su key (https://developer.riotgames.com).
# La development key expira cada 24 h: cuando expire, generen otra y reemplácenla aquí.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Texto cualquiera para anonimizar jugadores. Todo el equipo debe usar EL MISMO valor
# para que el mismo jugador tenga el mismo id en los datos de todos.
PUUID_SALT=pongan-aqui-un-texto-secreto
